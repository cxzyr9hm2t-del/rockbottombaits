# ═══════════════════════════════════════════════
# Rock Bottom Baits — Environment Variables
# Copy this file to .env.local and fill in values
# ═══════════════════════════════════════════════

# ── Stripe (Payments & Subscriptions) ──
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ── Supabase (Database & Auth) ──
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (SMS Notifications) ──
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_PHONE_NUMBER=+1613XXXXXXX

# ── Google Analytics ──
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Mailchimp (Email Marketing) ──
VITE_MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-usXX
VITE_MAILCHIMP_LIST_ID=xxxxxxxxxx

# ── Canada Post (Shipping API) ──
VITE_CANADAPOST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CANADAPOST_CUSTOMER_NUMBER=XXXXXXX

# ── Facebook Pixel ──
VITE_FB_PIXEL_ID=XXXXXXXXXXXXXXXX

# ── Site Configuration ──
VITE_SITE_URL=https://rockbottombaits.com
VITE_SITE_NAME=Rock Bottom Baits
